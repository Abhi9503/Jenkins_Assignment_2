pipeline {
    agent any
    environment {
        GIT_REPO_NAME = "Jenkins_Python_App_01"
        GIT_USER_NAME = "Abhi9503"
        GITHUB_TOKEN = credentials('github')
    }
    stages {
        stage('Checkout') {
            steps {
                git(
                    url: 'https://github.com/Abhi9503/Jenkins_Assignment_2.git',
                    credentialsId: 'github'
                )
            }
        }
        stage('Copy to D Drive') {
            steps {
                script {
                    if (env.GIT_BRANCH == 'origin/prod' || env.BRANCH_NAME == 'prod') {
                        bat 'xcopy /E /I /Y index.html "D:\\Prod\\"'
                    } else if (env.GIT_BRANCH == 'origin/Test' || env.BRANCH_NAME == 'Test') {
                        bat 'xcopy /E /I /Y index.html "D:\\Test\\"'
                    } else {
                        echo "Branch not configured for deployment: ${env.GIT_BRANCH}"
                    }
                }
            }
        }
    }
}
