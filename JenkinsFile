pipeline {
    agent any
    environment {
        GIT_REPO_NAME = "Jenkins_Python_App_01"
        GIT_USER_NAME = "Abhi9503"
        GITHUB_TOKEN = credentials('github')
    }
    stages {
        stage('Checkout') {
            steps {
                // Checkout the branch that triggered the build
                checkout scm
            }
        }
        stage('Copy to D Drive') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'prod') {
                        bat 'xcopy /E /I /Y index.html "D:\\Prod\\"'
                    } else if (env.BRANCH_NAME == 'Test') {
                        bat 'xcopy /E /I /Y index.html "D:\\Test\\"'
                    } else {
                        echo "Branch not configured for deployment: ${env.BRANCH_NAME}"
                    }
                }
            }
        }
    }
}
